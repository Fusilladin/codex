+    #[test]
+    fn alt_u_respects_disabled_and_release_events_and_empty_draft() {
+        let (mut composer, _rx) = new_test_composer();
+        composer.set_text_content("keep".to_string(), Vec::new(), Vec::new());
+        let mut release = KeyEvent::new(KeyCode::Char('u'), KeyModifiers::ALT);
+        release.kind = KeyEventKind::Release;
+        composer.handle_key_event(release);
+        assert_eq!(composer.current_text(), "keep");
+        composer.set_input_enabled(false, None);
+        composer.handle_key_event(KeyEvent::new(KeyCode::Char('u'), KeyModifiers::ALT));
+        assert_eq!(composer.current_text(), "keep");
+        composer.set_input_enabled(true, None);
+        composer.handle_key_event(KeyEvent::new(KeyCode::Char('u'), KeyModifiers::ALT));
+        composer.handle_key_event(KeyEvent::new(KeyCode::Char('u'), KeyModifiers::ALT));
+        assert!(composer.is_empty());
+        assert_eq!(
+            composer
+                .history
+                .navigate_up(&composer.app_event_tx)
+                .unwrap()
+                .text,
+            "keep"
+        );
+    }
