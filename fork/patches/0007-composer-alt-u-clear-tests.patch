+    // Modified by the fork maintainer: whole-draft clear is distinct from line kill.
+    #[test]
+    fn alt_u_clears_multiline_at_any_cursor_and_keeps_ctrl_u() {
+        let text = "first\nβeta\nlast";
+        let (mut composer, mut rx) = new_test_composer();
+        for cursor in [0, "first\nβ".len(), text.len()] {
+            composer.set_text_content(text.to_string(), Vec::new(), Vec::new());
+            composer.draft.textarea.set_cursor(cursor);
+            let (result, redraw) =
+                composer.handle_key_event(KeyEvent::new(KeyCode::Char('u'), KeyModifiers::ALT));
+            assert!(matches!(result, InputResult::None));
+            assert!(redraw);
+            assert!(composer.is_empty());
+            assert_eq!(composer.current_cursor(), 0);
+            assert!(
+                rx.try_recv().is_err(),
+                "clearing must not send or interrupt a turn"
+            );
+        }
+        composer.set_text_content(text.to_string(), Vec::new(), Vec::new());
+        composer.draft.textarea.set_cursor("first\nβeta".len());
+        composer.handle_key_event(KeyEvent::new(KeyCode::Char('u'), KeyModifiers::CONTROL));
+        assert_eq!(composer.current_text(), "first\n\nlast");
+    }
