+    #[test]
+    fn alt_u_clears_pending_paste_images_and_restores_draft_from_history() {
+        let (mut composer, _rx) = new_test_composer();
+        let large = "x".repeat(LARGE_PASTE_CHAR_THRESHOLD + 5);
+        let image = PathBuf::from("example.png");
+        let remote = "https://example.com/remote.png".to_string();
+        composer.handle_paste(large.clone());
+        composer.attach_image(image.clone());
+        composer.set_remote_image_urls(vec![remote.clone()]);
+        let before = composer.current_text();
+        composer.handle_key_event(KeyEvent::new(KeyCode::Char('u'), KeyModifiers::ALT));
+        assert!(composer.is_empty());
+        assert!(composer.draft.pending_pastes.is_empty());
+        assert!(composer.draft.textarea.text_elements().is_empty());
+        assert!(composer.local_image_paths().is_empty());
+        assert!(composer.attachments.remote_image_urls().is_empty());
+        let entry = composer
+            .history
+            .navigate_up(&composer.app_event_tx)
+            .unwrap();
+        assert_eq!(entry.text, before);
+        assert_eq!(entry.local_image_paths, vec![image.clone()]);
+        assert_eq!(entry.remote_image_urls, vec![remote.clone()]);
+        assert_eq!(entry.pending_pastes[0].1, large);
+        composer.apply_history_entry(entry);
+        assert_eq!(composer.current_text(), before);
+        assert_eq!(composer.local_image_paths(), vec![image]);
+        assert_eq!(composer.attachments.remote_image_urls(), vec![remote]);
+    }
