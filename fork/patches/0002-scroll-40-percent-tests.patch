+// Modified by the fork maintainer: test both patched transcript input paths.
+// These assertions use actual retained-cell anchors after real handler dispatch.
+fn check_scroll_40_transcript_path(ordinary_input: bool) {
+    use crate::history_cell::PlainHistoryCell;
+
+    let cells: Vec<Arc<dyn HistoryCell>> = vec![Arc::new(PlainHistoryCell::new(
+        (0..300).map(|row| format!("row {row:03}").into()).collect(),
+    ))];
+    for (height, page, half) in [(1, 1, 1), (2, 1, 1), (3, 1, 2), (5, 2, 3), (24, 9, 12), (60, 24, 30)] {
+        let area = Rect::new(0, 0, 20, height);
+        let mut view = TranscriptView::default();
+        view.render(area, &mut Buffer::empty(area), &cells);
+        // Ordinary input deliberately admits only unmodified PageUp/PageDown.
+        // Remap those real bindings to verify unchanged line and half-page branches
+        // without inventing extra keyboard routes that the handler does not accept.
+        for (action, step) in [("page", page), ("half", half), ("line", 1)] {
+            let mut keymap = crate::keymap::RuntimeKeymap::defaults().pager;
+            if action != "page" {
+                let up = std::mem::take(&mut keymap.page_up);
+                let down = std::mem::take(&mut keymap.page_down);
+                if action == "half" {
+                    keymap.half_page_up = up;
+                    keymap.half_page_down = down;
+                } else {
+                    keymap.scroll_up = up;
+                    keymap.scroll_down = down;
+                }
+            }
+            view.disclosure.keymap.pager = keymap.clone();
+            let dispatch = |view: &mut TranscriptView, code| {
+                let key = KeyEvent::new(code, KeyModifiers::NONE);
+                if ordinary_input {
+                    assert!(matches!(view.handle_scroll_key(key, &cells), Some(ViewAction::Changed)));
+                } else {
+                    assert!(view.navigate_pager(key, &cells, &keymap));
+                }
+            };
+            view.jump_to_beginning(&cells);
+            view.scroll(&cells, 100);
+            assert_eq!(view.start(&cells), (0, 100));
+            dispatch(&mut view, KeyCode::PageUp);
+            assert_eq!(view.start(&cells), (0, 100 - step), "{action}, height {height}");
+            dispatch(&mut view, KeyCode::PageDown);
+            assert_eq!(view.start(&cells), (0, 100));
+            dispatch(&mut view, KeyCode::PageDown);
+            assert_eq!(view.start(&cells), (0, 100 + step));
+            view.jump_to_beginning(&cells);
+            view.scroll(&cells, 1);
+            dispatch(&mut view, KeyCode::PageUp);
+            assert_eq!(view.start(&cells), (0, 0));
+            dispatch(&mut view, KeyCode::PageUp);
+            assert_eq!(view.start(&cells), (0, 0));
+            view.jump_to_latest();
+            let bottom = view.start(&cells);
+            assert_eq!(bottom, (0, 300 - usize::from(height)));
+            view.scroll(&cells, -1);
+            dispatch(&mut view, KeyCode::PageDown);
+            assert_eq!(view.start(&cells), bottom);
+            assert!(view.is_following());
+            dispatch(&mut view, KeyCode::PageDown);
+            assert_eq!(view.start(&cells), bottom);
+            assert!(view.is_following());
+        }
+    }
+}
+
+#[test]
+fn scroll_40_transcript_pager_steps_and_bounds() {
+    // Includes height 24 -> 9 (not pristine 24), in both directions.
+    check_scroll_40_transcript_path(false);
+}
+
+#[test]
+fn scroll_40_transcript_ordinary_input_steps_and_bounds() {
+    // Includes height 24 -> 9 (not pristine 23), in both directions.
+    check_scroll_40_transcript_path(true);
+}
