+    // Modified by the fork maintainer: exercise actual pager input and render bounds.
+    #[tokio::test(flavor = "current_thread", start_paused = true)]
+    async fn scroll_40_static_pager_steps_and_bounds() {
+        use crossterm::event::KeyModifiers;
+
+        let mut tui = crate::tui::test_support::make_test_tui().expect("test tui");
+        // Content heights exclude the two chrome rows. Explicit expected values avoid
+        // reproducing the production fraction in a test-only arithmetic helper.
+        for (height, page, half) in [(1, 1, 1), (2, 1, 1), (3, 1, 2), (5, 2, 3), (24, 9, 12), (60, 24, 30)] {
+            let area = Rect::new(0, 0, 40, height + 2);
+            let mut buffer = Buffer::empty(area);
+            let mut view = pager_view(vec![paragraph_block("row ", 300)], "scroll", 100);
+            view.render(area, &mut buffer);
+            assert_eq!(view.page_height(tui.terminal.viewport_area), usize::from(height));
+            for (up, down, modifiers, step) in [
+                (KeyCode::PageUp, KeyCode::PageDown, KeyModifiers::NONE, page),
+                (KeyCode::Char('u'), KeyCode::Char('d'), KeyModifiers::CONTROL, half),
+                (KeyCode::Up, KeyCode::Down, KeyModifiers::NONE, 1),
+            ] {
+                let up = KeyEvent::new(up, modifiers);
+                let down = KeyEvent::new(down, modifiers);
+                view.scroll_offset = 100;
+                view.handle_key_event(&mut tui, up).expect("up");
+                assert_eq!(view.scroll_offset, 100 - step, "height {height}");
+                view.handle_key_event(&mut tui, down).expect("down");
+                assert_eq!(view.scroll_offset, 100);
+                view.handle_key_event(&mut tui, down).expect("down from middle");
+                assert_eq!(view.scroll_offset, 100 + step);
+                view.scroll_offset = 1;
+                view.handle_key_event(&mut tui, up).expect("top");
+                assert_eq!(view.scroll_offset, 0);
+                view.handle_key_event(&mut tui, up).expect("remain at top");
+                assert_eq!(view.scroll_offset, 0);
+                let bottom = 300 - usize::from(height);
+                view.scroll_offset = bottom - 1;
+                view.handle_key_event(&mut tui, down).expect("bottom");
+                // The handler saturates arithmetic; the real render clamps content bounds.
+                view.render(area, &mut buffer);
+                assert_eq!(view.scroll_offset, bottom);
+                view.handle_key_event(&mut tui, down).expect("remain at bottom");
+                view.render(area, &mut buffer);
+                assert_eq!(view.scroll_offset, bottom);
+            }
+        }
+    }
